# Sao chép thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# ---------- Firebase (client) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-brando
NEXT_PUBLIC_FIREBASE_APP_ID=
# true = dùng Firebase Emulator Suite (Auth 9099, Firestore 8080)
NEXT_PUBLIC_USE_EMULATORS=true

# ---------- Nghiệp vụ ----------
# Đổi tên miền thì sửa cả firestore.rules
NEXT_PUBLIC_ALLOWED_DOMAIN=brando.vn
NEXT_PUBLIC_DISCOUNT_APPROVAL_THRESHOLD=10
NEXT_PUBLIC_VAT_PERCENT=8
NEXT_PUBLIC_QUOTE_VALIDITY_DAYS=15
NEXT_PUBLIC_DEFAULT_PAYMENT_TERMS=
NEXT_PUBLIC_DEFAULT_TIMELINE=
# Các email được cấp quyền admin khi đăng nhập lần đầu (phân cách bằng dấu phẩy)
ADMIN_EMAILS=
APP_BASE_URL=http://localhost:3000

# ---------- Firebase Admin (server) ----------
# JSON service account (nguyên văn hoặc base64). Bỏ trống khi dùng emulator.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Khi dùng emulator:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Google APIs ----------
# mock = dữ liệu mẫu, không gọi Google; live = gọi API thật
GOOGLE_MODE=mock
# Service account có quyền đọc các Sheet, sửa Docs/Drive (JSON nguyên văn hoặc base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tuỳ chọn: email user để service account mạo danh (cần domain-wide delegation)
GOOGLE_IMPERSONATE_USER=

PRICE_SHEET_ID=1KmYx9yNWi081cqg0cBvkq4LaTVorN8FGbDpmv8U9rHE
PRICE_SHEET_GID=802960658
RULES_SHEET_ID=
INDUSTRY_SHEET_ID=
STATS_SHEET_ID=
TEMPLATE_DOC_ID=
# Nên là thư mục trong Shared Drive mà service account là thành viên
ROOT_FOLDER_ID=

PLACES_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
