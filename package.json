{
  "name": "brando-sales-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-brando",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-brando \"vitest run tests/rules\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-brando \"playwright test\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^3.1.0",
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "re2": false
  }
}
